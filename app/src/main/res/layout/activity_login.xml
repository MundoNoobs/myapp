<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F4EB"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/imgIconoCasa"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_casa"
                        android:tint="#AC553E"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="casa / conectada"
                        android:textColor="#343C32"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvNumeroPantalla"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="02 / 05"
                        android:contentDescription="Pantalla 2 de 5"
                        android:textColor="#78786D"
                        android:textSize="12sp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal"
                    android:importantForAccessibility="no">

                    <View
                        android:id="@+id/paso1"
                        style="@style/CasaPaso"
                        android:background="@drawable/paso_activo" />

                    <View
                        android:id="@+id/paso2"
                        style="@style/CasaPaso"
                        android:background="@drawable/paso_activo" />

                    <View
                        android:id="@+id/paso3"
                        style="@style/CasaPaso" />

                    <View
                        android:id="@+id/paso4"
                        style="@style/CasaPaso" />

                    <View
                        android:id="@+id/paso5"
                        style="@style/CasaPaso" />

                </LinearLayout>

            </LinearLayout>

            <TextView
                style="@style/CasaEtapa"
                android:text="TU ESPACIO, SIEMPRE CERCA" />

            <TextView
                android:id="@+id/tvTituloLogin"
                style="@style/CasaTitulo"
                android:text="Bienvenido a casa" />

            <TextView
                style="@style/CasaDescripcion"
                android:text="Inicia sesión para conocer y cuidar tu hogar desde un solo lugar." />

            <LinearLayout
                style="@style/CasaTarjeta"
                android:layout_marginTop="24dp"
                android:orientation="vertical">

                <TextView
                    style="@style/CasaMarca"
                    android:text="Tu hogar, en tus manos" />

                <TextView
                    style="@style/CasaDescripcion"
                    android:text="Un espacio para estar conectados." />

            </LinearLayout>

            <TextView
                android:id="@+id/tvEtiquetaCorreo"
                style="@style/CasaEtiqueta"
                android:labelFor="@id/etCorreo"
                android:text="Correo electrónico" />

            <EditText
                android:id="@+id/etCorreo"
                style="@style/CasaCampo"
                android:hint="tu@correo.com"
                android:inputType="textEmailAddress"
                android:maxLines="1"
                android:autofillHints="emailAddress" />

            <TextView
                android:id="@+id/tvEtiquetaContrasena"
                style="@style/CasaEtiqueta"
                android:labelFor="@id/etContrasena"
                android:text="Contraseña" />

            <EditText
                android:id="@+id/etContrasena"
                style="@style/CasaCampo"
                android:hint="Escribe tu contraseña"
                android:inputType="textPassword"
                android:maxLines="1"
                android:autofillHints="password" />


            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnIniciarSesion"
                style="@style/CasaBoton"
                android:layout_marginTop="16dp"
                android:text="Iniciar Sesión" />

        </LinearLayout>
    </ScrollView>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnRetroceder"
        style="@style/CasaBotonSecundario"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        android:text="Retroceder" />

</LinearLayout>
