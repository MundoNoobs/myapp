<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F4EB"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/imgIconoCasa"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_casa"
                        android:tint="#AC553E"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="casa / conectada"
                        android:textColor="#343C32"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvNumeroPantalla"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="05 / 05"
                        android:contentDescription="Pantalla 5 de 5"
                        android:textColor="#78786D"
                        android:textSize="12sp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal"
                    android:importantForAccessibility="no">

                    <View
                        android:id="@+id/paso1"
                        style="@style/CasaPaso"
                        android:background="@drawable/paso_activo" />

                    <View
                        android:id="@+id/paso2"
                        style="@style/CasaPaso"
                        android:background="@drawable/paso_activo" />

                    <View
                        android:id="@+id/paso3"
                        style="@style/CasaPaso"
                        android:background="@drawable/paso_activo"/>

                    <View
                        android:id="@+id/paso4"
                        style="@style/CasaPaso"
                        android:background="@drawable/paso_activo"/>

                    <View
                        android:id="@+id/paso5"
                        style="@style/CasaPaso"
                        android:background="@drawable/paso_activo"/>

                </LinearLayout>

            </LinearLayout>


            <TextView
                style="@style/CasaEtapa"
                android:text="A TU GUSTO" />

            <TextView
                android:id="@+id/tvTituloControl"
                style="@style/CasaTitulo"
                android:text="Panel de control" />

            <TextView
                style="@style/CasaDescripcion"
                android:text="Pequeños ajustes para sentirte mejor en casa." />

            <LinearLayout
                style="@style/CasaTarjeta"
                android:orientation="vertical">

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchAire"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:checked="false"
                    android:text="Activar Aire"
                    android:textColor="#343C32"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    style="@style/CasaDescripcion"
                    android:text="Un ambiente fresco, cuando lo necesites." />

            </LinearLayout>

            <LinearLayout
                style="@style/CasaTarjeta"
                android:orientation="vertical">

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchLuces"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:checked="true"
                    android:text="Activar Luces"
                    android:textColor="#343C32"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    style="@style/CasaDescripcion"
                    android:text="La luz que acompaña cada momento." />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnRetroceder"
        style="@style/CasaBotonSecundario"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        android:text="Retroceder" />

</LinearLayout>
