<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F4EB"
    tools:context=".MainActivity">

    <ScrollView
        android:id="@+id/scrollContenido"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="24dp"
        android:paddingTop="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Icono, nombre y número de pantalla -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/imgIconoCasa"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_casa"
                            app:tint="#AC553E"
                            android:importantForAccessibility="no" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:text="casa / conectada"
                            android:textColor="#343C32"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvNumeroPantalla"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="01 / 05"
                            android:contentDescription="Pantalla 1 de 5"
                            android:textColor="#78786D"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <!-- Indicador de progreso -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal"
                        android:importantForAccessibility="no">

                        <View
                            android:id="@+id/paso1"
                            style="@style/CasaPaso"
                            android:background="@drawable/paso_activo" />

                        <View
                            android:id="@+id/paso2"
                            style="@style/CasaPaso"
                            />

                        <View
                            android:id="@+id/paso3"
                            style="@style/CasaPaso" />

                        <View
                            android:id="@+id/paso4"
                            style="@style/CasaPaso" />

                        <View
                            android:id="@+id/paso5"
                            style="@style/CasaPaso" />

                    </LinearLayout>

                </LinearLayout>


            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginTop="16dp"
                android:background="#E3DACE"
                />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="BIENVENIDOS A CASA"
                android:textColor="#AC553E"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Casa Inteligente"
                android:textColor="#343C32"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDescripcion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Un hogar que nos cuida. Un proyecto que construimos juntos."
                android:textColor="#78786D"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/imgCasa"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/fondo_ilustracion"
                android:clipToOutline="true"
                android:contentDescription="Ilustración de una casa inteligente"
                android:scaleType="fitCenter"
                android:src="@drawable/casa_ilustracion"
                />

            <TextView
                android:id="@+id/tvIntegrantes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Integrantes"
                android:textColor="#343C32"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvIntegrante1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/fondo_integrante"
                android:gravity="center_vertical"
                android:minHeight="52dp"
                android:padding="16dp"
                android:text="Victoria Jofré"
                android:textColor="#78786D"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvIntegrante2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/fondo_integrante"
                android:gravity="center_vertical"
                android:minHeight="52dp"
                android:padding="16dp"
                android:text="Israel Vera"
                android:textColor="#78786D"
                android:textSize="14sp" />

        </LinearLayout>

    </ScrollView>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/fondo_boton"
        android:minWidth="140dp"
        android:minHeight="48dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:text="Avanzar"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        app:backgroundTint="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
