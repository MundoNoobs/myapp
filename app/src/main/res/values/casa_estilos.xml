<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="CasaTexto">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#78786D</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="CasaMarca" parent="CasaTexto">
        <item name="android:textColor">#343C32</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CasaEtapa" parent="CasaTexto">
        <item name="android:layout_marginTop">28dp</item>
        <item name="android:textColor">#AC553E</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CasaTitulo" parent="CasaTexto">
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:textColor">#343C32</item>
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CasaDescripcion" parent="CasaTexto">
        <item name="android:layout_marginTop">8dp</item>
    </style>

    <style name="CasaEtiqueta" parent="CasaTexto">
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:textColor">#343C32</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CasaCampo">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:background">@drawable/fondo_integrante</item>
        <item name="android:padding">14dp</item>
        <item name="android:textColor">#343C32</item>
        <item name="android:textColorHint">#78786D</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="CasaTarjeta">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:background">@drawable/fondo_integrante</item>
        <item name="android:padding">16dp</item>
    </style>

    <style name="CasaNumero" parent="CasaTexto">
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:textColor">#343C32</item>
        <item name="android:textSize">32sp</item>
    </style>

    <style name="CasaBoton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:background">@drawable/fondo_boton</item>
        <item name="backgroundTint">@null</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="CasaBotonSecundario" parent="CasaBoton">
        <item name="android:background">@drawable/fondo_integrante</item>
        <item name="android:textColor">#343C32</item>
    </style>

    <style name="CasaPaso">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">3dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">2dp</item>
        <item name="android:layout_marginEnd">2dp</item>
        <item name="android:background">@drawable/paso_inactivo</item>
    </style>

</resources>
